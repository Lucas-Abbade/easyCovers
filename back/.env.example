# ==============================================================================
# EASYCOVERS - ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie a cópia para: .env
# 2. Preencha suas próprias credenciais abaixo.
# 3. NUNCA envie seu arquivo .env com senhas reais para o Git!
# ==============================================================================

# Integração Spotify API
SPOTIFY_CLIENT_ID=seu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback

# ==============================================================================
# CONFIGURAÇÃO DE ENVIO DE E-MAIL (VERIFICAÇÃO DE CADASTRO)
# ==============================================================================
# • EMAIL_DEV_MODE=True  -> MODO SIMULADO (Padrão para Dev / Sem Internet)
#   O código OTP de 6 dígitos é exibido no console do terminal.
#
# • EMAIL_DEV_MODE=False -> MODO REAL (Disparo SMTP na Caixa de Entrada)
#   Requer preencher SMTP_USERNAME e SMTP_PASSWORD abaixo.
EMAIL_DEV_MODE=True

# --- PROVEDOR DE E-MAIL (SMTP) ---
# Preset Gmail:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=seu_email@gmail.com
# Senha de App do Google (16 caracteres): https://myaccount.google.com/apppasswords
SMTP_PASSWORD=sua_senha_de_app_aqui

# Remetente exibido
SMTP_FROM_EMAIL=seu_email@gmail.com
SMTP_FROM_NAME=EasyCovers Studio

# Políticas de Tempo e Segurança (em minutos e segundos)
VERIFICATION_CODE_EXPIRE_MINUTES=15
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
